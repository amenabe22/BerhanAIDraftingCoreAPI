DOCGEN_API_URL=http://127.0.0.1:8000
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_URL=http://127.0.0.1:8765/mcp
MCP_SHARED_SECRET=dev-docgen-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Production (docker compose): set MCP_SHARED_SECRET in the repo-root .env.
# Compose overrides DOCGEN_API_URL to http://api:8000 so MCP reaches CoreAPI
# on the internal network. Do not use localhost inside the MCP container.
