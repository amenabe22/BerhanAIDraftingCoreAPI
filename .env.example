# ── Qdrant ────────────────────────────────────────────────────────────────────
# Remote Qdrant cloud or self-hosted URL
QDRANT_URL=https://your-qdrant-host:443
# Leave blank if your instance has no auth
QDRANT_API_KEY=

# Collection names (defaults shown; override if you use different names)
QDRANT_LEGAL_KNOWLEDGE_COLLECTION=BerhanAIDocumentKnowledgeCited
QDRANT_DEFAULT_COLLECTION=doc_blocks
KNOWLEDGE_EMBEDDING_DIMENSION=1024

# ── LLM via OpenRouter ────────────────────────────────────────────────────────
GEMINI_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=

# ── Cohere (embeddings + reranking) ──────────────────────────────────────────
COHERE_API_KEY=
COHERE_API_URL=https://api.cohere.com
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ── Semantic edit agent ───────────────────────────────────────────────────────
# EDIT_MODEL=google/gemini-2.5-flash
EDIT_RERANK_TOP_K=12
EDIT_SELECTOR_TOP_K=10
EDIT_MIN_CONFIDENCE=0.55
EDIT_MAX_REVISIONS=2

# ── Docker Compose overrides (optional) ──────────────────────────────────────
# Host port to bind the API on (default 8000)
# API_HOST_PORT=8080
