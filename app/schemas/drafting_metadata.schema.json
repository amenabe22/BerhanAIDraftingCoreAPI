{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://berhan.ai/schemas/drafting-metadata.schema.json",
  "title": "BerhanDraftingMetadata",
  "description": "Canonical metadata object for POST /drafting/generate (camelCase).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Document title"
    },
    "numPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "Target page count"
    },
    "purpose": {
      "type": "string",
      "description": "Short purpose / brief of the agreement"
    },
    "governingLaw": {
      "type": "string",
      "minLength": 1,
      "description": "e.g. Ethiopian law"
    },
    "jurisdiction": {
      "type": "string",
      "description": "e.g. Ethiopian courts"
    },
    "parties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 }
        },
        "required": ["name", "role"]
      }
    }
  },
  "required": ["title", "parties", "governingLaw"]
}
